# ==============================================================================
# Git Ignore Configuration
# Personalized AI Learning System (Deep Knowledge Tracing)
# ==============================================================================

# Byte-compiled / Python bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution & Build artifacts
build/
dist/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit local runtime settings
.streamlit/secrets.toml
.streamlit/credentials.toml

# Editor & IDE configurations
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs & Temporary files
*.log
*.tmp
scratch/
scratch_*.py
