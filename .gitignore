# ==============================================================================
# Git Ignore Configuration
# Personalized AI Learning System (Deep Knowledge Tracing)
# ==============================================================================

# Byte-compiled / Python bytecode cache
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual Environments & Local Package Installs
venv/
**/venv/
.venv/
**/.venv/
env/
**/env/
ENV/
**/ENV/
env.bak/
venv.bak/
.env
.env.*
!.env.example

# Distribution & Build artifacts
build/
**/build/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
out/
**/out/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit local runtime settings
.streamlit/secrets.toml
.streamlit/credentials.toml

# Node & Frontend dependencies
node_modules/
**/node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.npm/
.node_repl_history
*.local

# Microsoft Office temporary & lock files
~$*
~$*.docx
~$*.doc
~$*.pptx
~$*.xlsx

# Editor & IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs & Temporary files
logs/
*.log
*.tmp
scratch/
scratch_*.py

