# ==============================================================================
# Git Ignore Configuration
# Personalized AI Learning System (Deep Knowledge Tracing)
# ==============================================================================

# Byte-compiled / Python bytecode cache
__pycache__/
*.py[cod]
*$py.class
*.pyo
*.pyd

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution & Build artifacts
build/
dist/
dist-ssr/
*.egg-info/
*.egg

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Streamlit local runtime settings
.streamlit/secrets.toml
.streamlit/credentials.toml

# Node & Frontend dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
*.local

# Editor & IDE configurations
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln

# Operating System files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db

# Logs & Temporary files
logs/
*.log
*.tmp
scratch/
scratch_*.py
